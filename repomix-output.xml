          "lineHeight": 1.4,
          "children": [
            {
              "type": "text",
              "text": "Установите регулярное время для тренировок. Это поможет вам сделать занятия спортом ",
              "bold": false,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
