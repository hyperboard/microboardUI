  "2077cf47-48c3-449c-a1dd-96d76637b312": {
    "itemType": "AINode",
    "transformation": {
      "translateX": 407,
      "translateY": 3987,
      "scaleX": 1,
      "scaleY": 1,
      "rotate": 0,
