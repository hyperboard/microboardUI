              "type": "list_item",
              "horisontalAlignment": "left",
              "children": [
                {
                  "type": "paragraph",
                  "horisontalAlignment": "left",
                  "paddingTop": 0.5,
                  "lineHeight": 1.4,
                  "children": [
                    {
                      "type": "text",
                      "text": "Фитнес",
                      "bold": true,
                      "italic": false,
                      "underline": false,
                      "line-through": false,
                      "fontColor": "rgb(20, 21, 26)",
                      "fontHighlight": "",
                      "fontSize": 18,
