        },
        {
          "type": "heading_three",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "children": [
            {
              "type": "text",
              "text": "3. Создайте расписание",
              "bold": true,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
