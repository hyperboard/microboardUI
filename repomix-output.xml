  "9fcb8a59-a002-421d-9d39-e72d450432bf": {
    "itemType": "AINode",
    "transformation": {
      "translateX": 1096,
      "translateY": 4435,
      "scaleX": 1,
      "scaleY": 1,
      "rotate": 0,
      "isLocked": false
    },
    "text": {
      "itemType": "RichText",
      "verticalAlignment": "center",
      "children": [
        {
          "type": "paragraph",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "lineHeight": 1.4,
          "children": [
            {
              "type": "text",
              "text": "Чтобы начать заниматься спортом, важно учесть несколько ключевых аспектов, которые помогут вам сделать этот процесс более приятным и эффективным.",
              "bold": false,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
              "fontHighlight": "",
              "fontSize": 18,
              "fontFamily": "Manrope",
              "overline": false,
              "subscript": false,
              "superscript": false
            }
          ]
        },
        {
          "type": "heading_three",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "children": [
            {
              "type": "text",
              "text": "1. Определите свои цели",
              "bold": true,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
              "fontHighlight": "",
              "fontSize": 18,
              "fontFamily": "Manrope",
              "overline": false,
              "subscript": false,
              "superscript": false
            }
          ]
        },
        {
          "type": "paragraph",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "lineHeight": 1.4,
          "children": [
            {
              "type": "text",
              "text": "Подумайте, чего вы хотите достичь. Это может быть улучшение физической формы, похудение, увеличение мышечной массы или просто желание вести более активный образ жизни.",
              "bold": false,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
              "fontHighlight": "",
              "fontSize": 18,
              "fontFamily": "Manrope",
              "overline": false,
              "subscript": false,
              "superscript": false
            }
          ]
        },
        {
          "type": "heading_three",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "children": [
            {
              "type": "text",
              "text": "2. Выберите вид спорта",
              "bold": true,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
              "fontHighlight": "",
              "fontSize": 18,
              "fontFamily": "Manrope",
              "overline": false,
              "subscript": false,
              "superscript": false
            }
          ]
        },
        {
          "type": "paragraph",
          "horisontalAlignment": "left",
          "paddingTop": 0.5,
          "lineHeight": 1.4,
          "children": [
            {
              "type": "text",
              "text": "Исследуйте разные виды спорта и физической активности. Это могут быть:",
              "bold": false,
              "italic": false,
              "underline": false,
              "line-through": false,
              "fontColor": "rgb(20, 21, 26)",
              "fontHighlight": "",
              "fontSize": 18,
              "fontFamily": "Manrope",
              "overline": false,
              "subscript": false,
              "superscript": false
            }
          ]
        },
        {
          "type": "ul_list",
          "horisontalAlignment": "left",
          "children": [
            {
              "type": "list_item",
              "horisontalAlignment": "left",
              "children": [
                {
                  "type": "paragraph",
                  "horisontalAlignment": "left",
                  "paddingTop": 0.5,
                  "lineHeight": 1.4,
                  "children": [
                    {
                      "type": "text",
                      "text": "Бег",
                      "bold": true,
                      "italic": false,
                      "underline": false,
                      "line-through": false,
                      "fontColor": "rgb(20, 21, 26)",
                      "fontHighlight": "",
                      "fontSize": 18,
                      "fontFamily": "Manrope",
                      "overline": false,
                      "subscript": false,
                      "superscript": false
                    },
                    {
                      "type": "text",
                      "text": ": отличное кардионагрузка, которую можно делать в любом месте.",
