              "children": [
                {
                  "type": "paragraph",
                  "horisontalAlignment": "left",
                  "paddingTop": 0.5,
                  "lineHeight": 1.4,
                  "children": [
                    {
                      "type": "text",
                      "text": "Командные виды спорта",
