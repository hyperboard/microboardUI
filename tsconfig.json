{
  "include": ["src/**/*", "src/css-module.d.ts"],
  "exclude": ["public", "dist", "node_modules", "scripts", "docs", "examples"],
  "compilerOptions": {
    "lib": ["ES2017", "DOM", "ES2019"],
    "target": "es2022",
    "module": "es2022",
    "sourceMap": true,
    "types": ["react", "wicg-file-system-access"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "strict": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "src",
    "paths": {
      "*": ["*", "*.js", "*.ts", "*.tsx"],
      "App/*": ["./App/*"],
      "features/*": ["./features/*"],
      "entities/*": ["./entities/*"],
      "pages/*": ["./pages/*"],
      "public/*": ["./public/*"],
      "shared/*": ["./shared/*"],
      "*/": ["./*"]
    }
  },
  "ts-node": {
    "files": true
  }
}
